# Copy this file to .env and modify values as needed:
#   cp deploy/.env.example deploy/.env

# Docker image tag to use
TAG=latest

# HTTP port the server listens on
PORT=8181

# Path where wipe history (history.json) is persisted.
# Use a Docker volume to retain history across container restarts.
DATA_DIR=/data

# Set to 1 to bypass the removable-device check on the USB bus.
# Required for some USB SSD enclosures that report removable=0 in sysfs.
# All other safety checks remain active. USE WITH CAUTION.
UNSAFE_ALLOW_ALL_USB=0
